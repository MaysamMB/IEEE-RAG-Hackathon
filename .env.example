# Any OpenAI-compatible service works. Keep exactly one block active.
# Free tiers and model names change often: check the provider's console before the event.

# Groq (free key from console.groq.com; model list in the console)
LLM_API_KEY=replace_with_your_free_api_key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Google Gemini (free key from aistudio.google.com; check its data-use terms for the free tier)
# LLM_API_KEY=replace_with_your_free_api_key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=replace_with_a_free_gemini_model

# OpenRouter (use a model whose name ends in :free)
# LLM_API_KEY=replace_with_your_free_api_key
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=replace_with_a_model_ending_in_:free

# Ollama (runs on your laptop, no internet or real key; run: ollama pull <model>)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=replace_with_a_pulled_model

# Local multilingual embedding model, chosen on Arabic test questions; re-check on the challenge data.
EMBEDDING_MODEL=intfloat/multilingual-e5-small

OCR_CACHE_DIR=data/processed/ocr_cache
CHROMA_PERSIST_DIR=storage/chroma
CHROMA_COLLECTION=hackathon_documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
# Leave blank until calibrated on in-domain and out-of-domain questions.
MAX_COSINE_DISTANCE=
# USD per million tokens for your model. Leave blank on a free tier.
INPUT_PRICE_PER_MTOK=
OUTPUT_PRICE_PER_MTOK=

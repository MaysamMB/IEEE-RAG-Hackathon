# API calls made by this Python RAG app are separate from Claude chat/Claude Code plan usage.
ANTHROPIC_API_KEY=replace_with_your_api_key
ANTHROPIC_MODEL=replace_with_a_model_available_to_your_api_account

# Local multilingual embedding model; evaluate on the actual challenge data before finalizing.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

CHROMA_PERSIST_DIR=storage/chroma
CHROMA_COLLECTION=hackathon_documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
# Leave blank until calibrated on in-domain and out-of-domain questions.
MAX_COSINE_DISTANCE=
